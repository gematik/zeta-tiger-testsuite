# configuration file /etc/nginx/nginx.conf:
include main_modules.conf;
include main_common.conf;
events { worker_connections 512; }
http {
    include http_common.conf;
    pep_require_popp off;
    pep_forward_client_data off;
    upstream pep-pep-upstream { server tiger-proxy:443; keepalive 32; }
    server {
        include server_common.conf;
        listen 8081;
        server_name pep-proxy-svc;
        include proxy_headers.conf;
        include asl.conf;
        location /.well-known/ {
            pep off;
            location = /.well-known/oauth-authorization-server { proxy_pass http://authserver/auth/realms/zeta-guard/.well-known/zeta-guard-well-known; }
        }
        location ~ ^/auth/admin { return 403; }
        location ~ ^/push/v1/channels/([^/]+)$ { return 403; }
        location = /pep {
            proxy_pass https://pep-pep-upstream/testfachdienst;
            include proxy_headers.conf;
        }
        location /pep/ {
            proxy_pass https://pep-pep-upstream/testfachdienst/;
            include proxy_headers.conf;
            ## with an `upstream {}` block, nginx's default Host ($proxy_host) is the
            ## upstream block NAME.
            proxy_set_header Host "tiger-proxy:443";
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_ssl_server_name on;
            proxy_ssl_name tiger-proxy;
            pep_require_popp off;
            pep_forward_client_data off;
            pep_require_scope "old";
            pep_require_aud "old";
        }
    }
    server { listen 8080; location = /status { return 200; } }
}

# configuration file /etc/nginx/main_common.conf:
env RUST_LOG;
env RUST_TRACE;

# https://docs.rs/opentelemetry_sdk/0.32.1/opentelemetry_sdk/
env OTEL_SERVICE_NAME;
env OTEL_RESOURCE_ATTRIBUTES;

env OTEL_TRACES_SAMPLER;
env OTEL_TRACES_SAMPLER_ARG;

env OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT;
env OTEL_SPAN_EVENT_COUNT_LIMIT;
env OTEL_SPAN_LINK_COUNT_LIMIT;

env OTEL_BSP_SCHEDULE_DELAY;
env OTEL_BSP_MAX_QUEUE_SIZE;
env OTEL_BSP_MAX_EXPORT_BATCH_SIZE;
env OTEL_BSP_MAX_CONCURRENT_EXPORTS;

env OTEL_BLRP_SCHEDULE_DELAY;
env OTEL_BLRP_MAX_QUEUE_SIZE;
env OTEL_BLRP_MAX_EXPORT_BATCH_SIZE;

env OTEL_METRIC_EXPORT_INTERVAL;

# NOTE: the only supported OTEL_EXPORTER_* env. The protocol is always gRPC.
env OTEL_EXPORTER_OTLP_ENDPOINT;

# configuration file /etc/nginx/http_common.conf:
# for websockets
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}
proxy_read_timeout 300s;

# A_26920: ZETA/ASL mindestens HTTP-Version 1.1
map $server_protocol $reject_proto {
    "HTTP/1.1" 0; # fast-path
    "HTTP/2.0" 0;
    ~*^HTTP/1\.1$ 0; # case-insensitive
    ~*^HTTP/2\.0$ 0;
    default 1; # reject everything else
}

server_tokens off;

include mime.types;
default_type application/octet-stream;

log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                '$status $body_bytes_sent ${request_time}s (${upstream_connect_time},${upstream_header_time},${upstream_response_time}) "$http_referer" '
                '"$http_user_agent" "$http_x_forwarded_for"';

sendfile on;
aio threads;
aio_write on;
tcp_nopush on;

log_subrequest on;

reset_timedout_connection on;

# configuration file /etc/nginx/server_common.conf:
http2 on;

# A_26920: ZETA/ASL mindestens HTTP-Version 1.1
if ($reject_proto) {
    return 444;
}

location /doc/ {
  pep off;
}

# configuration file /etc/nginx/proxy_headers.conf:
# proxy_headers.conf
#
# Include this in EVERY pep-protected `proxy_pass` location. The PEP enforces the include at
# request time: a proxied location missing it returns HTTP 500 (ProxyHeadersMissing) instead of
# silently forwarding client credentials upstream.
#
# IMPORTANT: nginx's `proxy_set_header` inheritance is non-additive — a location that declares
# *any* `proxy_set_header` of its own does NOT inherit the parent's set. So if you add your own
# `proxy_set_header` in a (nested) location, you MUST re-`include proxy_headers.conf` there too,
# or these strips are dropped. The PEP's sentinel check below catches a fully-missing include;
# re-including on customization is on you.

# Credentials the PEP consumes (Authorization / DPoP / PoPP) authenticate the client *to the
# PEP*; they are not meant for the upstream. Empty value → the header is omitted from the
# upstream request, and the name in the proxy header set drops any client-supplied copy.
# Update: To fulfill A_25669-01 this behavior is temporarily changed. Now the authorization,
# dpop and popp headers are forwarded to the upstream and not overridden by PEP.
# In future versions this will be configurable.
# proxy_set_header authorization "";
# proxy_set_header dpop "";
# proxy_set_header popp "";

# this is a response header that shouldn't be forwarded upstream
proxy_set_header ZETA-API-Version        "";

# The ZETA-* headers the PEP injects: the value comes from a PEP-set nginx variable (empty when
# the PEP didn't set it this request → header omitted). Naming each here ALSO drops any
# client-supplied copy of that name — the PEP is the sole source (A_25669-01). ZETA-API-Version
# is a response header the PEP sets separately, so on the request path it is only stripped.
proxy_set_header ZETA-User-Info          $zeta_user_info;
proxy_set_header ZETA-Client-Data        $zeta_client_data;
proxy_set_header ZETA-PoPP-Token-Content $zeta_popp_token_content;
proxy_set_header Forwarded               $zeta_forwarded;

# Enforcement sentinel. The empty value means it is never forwarded; the PEP only checks that
# its *name* is present in this location's compiled proxy header set. Keep it lowercase.
proxy_set_header x-zeta-headers-applied "";

# configuration file /etc/nginx/asl.conf:
location /CertData. {
    asl on;
    pep off;

    satisfy all;
    allow all;
}

location /ASL {
    pep on;
    asl on;
    pep_require_popp off;

    client_body_buffer_size 1m;
    client_max_body_size 1m;

    satisfy all;
    allow all;
}

# configuration file /etc/nginx/mime.types:
types {
    text/html html htm shtml;
    text/plain txt;
    application/json json;
    image/png png;
}

# configuration file /etc/nginx/main_modules.conf:
load_module modules/libngx_pep.so;
# https://github.com/openresty/headers-more-nginx-module
load_module modules/ngx_http_headers_more_filter_module.so;
